{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-agent/interior-agent-review/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rendererVersion", "revision", "targets", "style"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "rendererVersion": { "const": 2 },
    "revision": { "type": "integer", "minimum": 1 },
    "targets": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "observations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "needs-change", "blocked"] },
          "observations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedStyleId", "effectRenderBindingReady", "observations"],
      "properties": {
        "selectedStyleId": { "type": "string", "minLength": 1 },
        "effectRenderBindingReady": { "const": true },
        "observations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
