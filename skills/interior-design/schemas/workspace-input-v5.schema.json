{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-agent/interior-workspace-input/v5",
  "title": "Interior Workspace Input V5",
  "type": "object",
  "required": ["schemaVersion", "project", "brief", "evidence", "requirements", "geometry", "design"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "project": { "type": "object", "required": ["projectId", "title", "revision"], "properties": { "projectId": {"type":"string","pattern":"^[a-z][a-z0-9_-]{2,63}$"}, "title":{"type":"string","minLength":1}, "revision":{"type":"integer","minimum":1} } },
    "brief": { "type": "object" },
    "evidence": { "type": "array", "items": { "type": "object", "required": ["id", "file", "kind", "allowedUses"], "properties": { "id":{"type":"string"}, "file":{"type":"string"}, "kind":{"type":"string"}, "allowedUses":{"type":"array","items":{"type":"string"}}, "prohibitedUses":{"type":"array","items":{"type":"string"}}, "expectedSha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"} } } },
    "requirements": { "type": "array", "minItems": 1 },
    "assumptions": { "type": "array" },
    "unknowns": { "type": "array" },
    "professionalVerifications": { "type": "array" },
    "geometry": { "type": "object" },
    "design": { "type": "object" }
  }
}
