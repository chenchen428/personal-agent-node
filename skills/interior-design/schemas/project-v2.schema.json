{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent.local/schemas/interior-design/project-v2.schema.json",
  "title": "Personal Agent professional interior-design project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "spaceId",
    "ownerId",
    "title",
    "status",
    "designStage",
    "revision",
    "baseRevision",
    "createdAt",
    "updatedAt",
    "evidence",
    "brief",
    "assumptions",
    "unknowns",
    "professionalVerifications",
    "concepts",
    "selectedConceptId",
    "designIntent",
    "decisions",
    "demandWorkflow",
    "scene",
    "quality",
    "publication",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "projectId": { "type": "string", "pattern": "^renovation_[a-z0-9][a-z0-9_-]{5,119}$" },
    "spaceId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "ownerId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": { "$ref": "#/$defs/status" },
    "designStage": { "const": "concept" },
    "revision": { "type": "integer", "minimum": 1 },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "brief": { "$ref": "#/$defs/brief" },
    "assumptions": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/assumption" }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/unknown" }
    },
    "professionalVerifications": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/professionalVerification" }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/concept" }
    },
    "selectedConceptId": { "$ref": "#/$defs/id" },
    "designIntent": { "$ref": "#/$defs/designIntent" },
    "decisions": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/decision" }
    },
    "demandWorkflow": { "$ref": "#/$defs/demandWorkflow" },
    "scene": { "$ref": "#/$defs/scene" },
    "quality": { "$ref": "#/$defs/quality" },
    "publication": { "type": "object" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "point2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point2" }
    },
    "status": {
      "enum": [
        "intake",
        "evidence_classified",
        "calibrated",
        "functional_discovery",
        "layout_review",
        "style_calibration",
        "render_storyboard",
        "render_review",
        "brief_frozen",
        "concept_options",
        "selected_concept",
        "scene_compiled",
        "quality_gated",
        "page_generated",
        "published",
        "user_visual_acceptance_pending",
        "accepted",
        "revised",
        "blocked_missing_evidence",
        "blocked_professional_verification",
        "superseded",
        "archived"
      ]
    },
    "demandWorkflow": {
      "description": "Read-only legacy projection retained solely for deterministic regeneration of the committed representative delivery. Current workflow authority is agents/interior-designer/workflow.json schema v2.",
      "deprecated": true,
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "purpose", "stage", "status", "openQuestions", "confirmations", "transitions", "styleProfile", "renderStoryboard", "renderSet", "staleArtifacts"],
      "properties": {
        "version": { "const": 1 },
        "purpose": { "const": "requirements-discovery" },
        "stage": { "$ref": "#/$defs/demandWorkflowStage" },
        "status": { "enum": ["awaiting-user", "in-progress", "confirmed", "user-visual-acceptance-pending"] },
        "openQuestions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/demandQuestion" } },
        "confirmations": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/demandConfirmation" } },
        "transitions": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/demandTransition" } },
        "styleProfile": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/styleProfile" }] },
        "renderStoryboard": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/renderShot" } },
        "renderSet": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/conceptRenderRecord" } },
        "staleArtifacts": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "demandWorkflowStage": {
      "enum": ["intake", "functional-discovery", "layout-review", "style-calibration", "render-storyboard", "render-review", "brief-frozen", "delivered"]
    },
    "demandQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "stage", "prompt", "required", "status"],
      "properties": {
        "questionId": { "$ref": "#/$defs/id" },
        "stage": { "$ref": "#/$defs/demandWorkflowStage" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" },
        "status": { "enum": ["open", "answered", "deferred"] },
        "answer": { "type": "string", "maxLength": 2000 }
      }
    },
    "demandConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmationId", "stage", "projectRevision", "source", "scope", "confirmedAt"],
      "properties": {
        "confirmationId": { "$ref": "#/$defs/id" },
        "stage": { "$ref": "#/$defs/demandWorkflowStage" },
        "projectRevision": { "type": "integer", "minimum": 1 },
        "source": { "const": "user" },
        "scope": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "confirmedAt": { "type": "string", "format": "date-time" }
      }
    },
    "demandTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "projectRevision", "confirmationId", "at", "summary"],
      "properties": {
        "from": { "$ref": "#/$defs/demandWorkflowStage" },
        "to": { "$ref": "#/$defs/demandWorkflowStage" },
        "projectRevision": { "type": "integer", "minimum": 2 },
        "confirmationId": { "$ref": "#/$defs/id" },
        "at": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "maxLength": 1000 }
      }
    },
    "styleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "primary", "secondary"],
      "properties": {
        "status": { "enum": ["candidate", "confirmed"] },
        "primary": { "$ref": "#/$defs/styleDirection" },
        "secondary": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/styleDirection" }] }
      }
    },
    "styleDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["styleId", "label", "observable", "borrow", "avoid"],
      "properties": {
        "styleId": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "observable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contrast", "woodTone", "surface", "lighting", "visualDensity"],
          "properties": {
            "contrast": { "type": "string", "minLength": 1, "maxLength": 300 },
            "woodTone": { "type": "string", "minLength": 1, "maxLength": 300 },
            "surface": { "type": "string", "minLength": 1, "maxLength": 300 },
            "lighting": { "type": "string", "minLength": 1, "maxLength": 300 },
            "visualDensity": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "borrow": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "avoid": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      }
    },
    "renderShot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shotId", "sequence", "space", "role", "purpose", "requirementIds", "status"],
      "properties": {
        "shotId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "space": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "enum": ["room-context", "supporting-view", "private-space", "detail"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "requirementIds": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/id" } },
        "status": { "enum": ["planned", "approved", "rendered", "stale"] }
      }
    },
    "conceptRenderRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderId", "shotId", "evidenceId", "styleId", "sequence", "status", "promptSha256", "referenceSetSha256"],
      "properties": {
        "renderId": { "$ref": "#/$defs/id" },
        "shotId": { "$ref": "#/$defs/id" },
        "evidenceId": { "$ref": "#/$defs/id" },
        "styleId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["candidate", "selected", "rejected", "stale"] },
        "promptSha256": { "$ref": "#/$defs/sha256" },
        "referenceSetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "classification",
        "orientation",
        "calibration",
        "confidence",
        "allowedUses",
        "observations",
        "inferences",
        "redactionStatus",
        "contentHash"
      ],
      "anyOf": [
        { "required": ["managedObjectId"] },
        { "required": ["relativePath"] }
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/id" },
        "managedObjectId": { "type": "string", "pattern": "^obj_[a-f0-9]{24}$" },
        "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "classification": { "enum": ["structure-reference", "revision-annotation", "concept-render", "style-reference", "edit-target", "site-photo", "measurement"] },
        "orientation": { "type": "string", "minLength": 1, "maxLength": 120 },
        "calibration": {
          "type": "object",
          "required": ["basis"],
          "properties": {
            "basis": { "enum": ["known-length", "multiple-lengths", "drawing-scale", "estimated", "unknown"] },
            "segmentId": { "$ref": "#/$defs/id" },
            "referenceId": { "$ref": "#/$defs/id" },
            "knownLengthMetres": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "enum": ["m", "cm", "mm"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "metresPerUnit": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": true
        },
        "confidence": { "enum": ["verified", "specified", "estimated", "unknown"] },
        "allowedUses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "observations": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
        "inferences": { "type": "array", "items": { "type": "string", "maxLength": 2000 } },
        "redactionStatus": { "enum": ["not-required", "redacted", "private-only"] },
        "generation": {
          "type": "object",
          "required": ["generator", "referenceImageSha256", "promptSha256"],
          "properties": {
            "generator": { "const": "imagegen" },
            "referenceImageSha256": { "$ref": "#/$defs/sha256" },
            "promptSha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "contentHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["household", "scope", "budget", "schedule", "requirements"],
      "properties": {
        "household": { "type": "array", "items": {} },
        "scope": { "type": "array", "items": { "type": "string", "maxLength": 240 } },
        "budget": {
          "type": "object",
          "required": ["currency", "totalMinor", "confidence"],
          "properties": {
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "totalMinor": { "type": "integer", "minimum": 0 },
            "confidence": { "enum": ["verified", "specified", "estimated", "unknown"] }
          },
          "additionalProperties": true
        },
        "schedule": {
          "type": "object",
          "required": ["confidence", "phases"],
          "properties": {
            "confidence": { "enum": ["verified", "specified", "estimated", "unknown"] },
            "phases": { "type": "array", "items": { "$ref": "#/$defs/schedulePhase" } }
          },
          "additionalProperties": true
        },
        "requirements": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/requirement" }
        },
        "qualityThresholds": {
          "type": "object",
          "properties": {
            "minimumPassageWidthMetres": { "$ref": "#/$defs/qualityThreshold" }
          },
          "additionalProperties": false
        }
      }
    },
    "qualityThreshold": {
      "type": "object",
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "source": { "enum": ["user-requirement", "jurisdiction-rule", "product-concept-default", "comfort-guidance"] },
        "reference": { "type": "string", "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["requirementId", "source", "priority", "status", "sceneNodeIds", "verification"],
      "properties": {
        "requirementId": { "$ref": "#/$defs/id" },
        "source": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "summary": { "type": "string", "maxLength": 2000 },
        "priority": { "enum": ["must", "should", "prefer", "avoid"] },
        "status": { "enum": ["unresolved", "satisfied", "partially-satisfied", "blocked", "rejected-with-reason"] },
        "sceneNodeIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "verification": { "type": "object" },
        "budgetItemIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "phaseIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "decisionIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "rationale": { "type": "string", "maxLength": 2000 },
        "alternative": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": true
    },
    "schedulePhase": {
      "type": "object",
      "required": ["phaseId", "name"],
      "properties": {
        "phaseId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "enum": ["planned", "in-progress", "completed", "blocked"] },
        "scopeIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "professionalVerificationIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": true
    },
    "budgetItem": {
      "type": "object",
      "required": ["budgetItemId", "category", "amountMinor", "confidence"],
      "properties": {
        "budgetItemId": { "$ref": "#/$defs/id" },
        "category": { "type": "string", "minLength": 1, "maxLength": 160 },
        "name": { "type": "string", "maxLength": 240 },
        "amountMinor": { "type": "integer", "minimum": 0 },
        "confidence": { "enum": ["verified", "specified", "estimated"] },
        "scopeIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "phaseIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": true
    },
    "assumption": {
      "type": "object",
      "required": ["assumptionId", "summary"],
      "properties": {
        "assumptionId": { "$ref": "#/$defs/id" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "confidence": { "enum": ["verified", "specified", "estimated", "unknown"] }
      },
      "additionalProperties": true
    },
    "unknown": {
      "type": "object",
      "required": ["unknownId", "summary"],
      "properties": {
        "unknownId": { "$ref": "#/$defs/id" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "additionalProperties": true
    },
    "professionalVerification": {
      "type": "object",
      "required": ["verificationId", "category", "status", "summary"],
      "properties": {
        "verificationId": { "$ref": "#/$defs/id" },
        "category": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "enum": ["required", "pending", "verified", "not-applicable"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "owner": { "type": "string", "maxLength": 240 },
        "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": true
    },
    "concept": {
      "type": "object",
      "required": ["conceptId", "sourcePlanEvidenceId", "name", "summary", "tradeoffs", "budgetItems", "levels"],
      "properties": {
        "conceptId": { "$ref": "#/$defs/id" },
        "sourcePlanEvidenceId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "singleOptionReason": { "type": "string", "maxLength": 2000 },
        "tradeoffs": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
        "budgetItems": { "type": "array", "items": { "$ref": "#/$defs/budgetItem" } },
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/level" }
        }
      },
      "additionalProperties": true
    },
    "level": {
      "type": "object",
      "required": ["levelId", "name", "elevation", "height", "footprint", "rooms", "walls", "openings", "items", "stairs", "guardrails", "voids"],
      "properties": {
        "levelId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "elevation": { "type": "number" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "footprint": { "$ref": "#/$defs/polygon" },
        "rooms": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/room" } },
        "walls": { "type": "array", "items": { "$ref": "#/$defs/wall" } },
        "openings": { "type": "array", "items": { "$ref": "#/$defs/opening" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "stairs": { "type": "array", "items": { "$ref": "#/$defs/stair" } },
        "guardrails": { "type": "array", "items": { "$ref": "#/$defs/guardrail" } },
        "voids": { "type": "array", "items": { "$ref": "#/$defs/void" } }
      },
      "additionalProperties": true
    },
    "room": {
      "type": "object",
      "required": ["roomId", "name", "kind", "polygon", "materialId"],
      "properties": {
        "roomId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 120 },
        "polygon": { "$ref": "#/$defs/polygon" },
        "materialId": { "$ref": "#/$defs/id" },
        "requiredAccess": { "type": "boolean" },
        "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "requirementIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": true
    },
    "wall": {
      "type": "object",
      "required": ["wallId", "start", "end", "height", "thickness"],
      "properties": {
        "wallId": { "$ref": "#/$defs/id" },
        "start": { "$ref": "#/$defs/point2" },
        "end": { "$ref": "#/$defs/point2" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "exteriorEdge": { "type": "integer", "minimum": -1 }
      },
      "additionalProperties": true
    },
    "opening": {
      "type": "object",
      "required": ["openingId", "type", "wallId", "position", "width", "height", "connectsRoomIds"],
      "properties": {
        "openingId": { "$ref": "#/$defs/id" },
        "type": { "enum": ["door", "window"] },
        "wallId": { "$ref": "#/$defs/id" },
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "sillHeight": { "type": "number", "minimum": 0 },
        "connectsRoomIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "isEntry": { "type": "boolean" },
        "hingesSide": { "enum": ["left", "right"] },
        "swingDirection": { "enum": ["inward", "outward"] }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["itemId", "name", "kind", "roomId", "position", "size", "rotation"],
      "properties": {
        "itemId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 120 },
        "roomId": { "$ref": "#/$defs/id" },
        "position": { "$ref": "#/$defs/point2" },
        "size": {
          "type": "array",
          "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }],
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": { "type": "number" },
        "materialId": { "$ref": "#/$defs/id" },
        "color": { "type": "string", "maxLength": 40 },
        "assetProfile": { "$ref": "#/$defs/assetProfile" },
        "clearanceExempt": { "type": "boolean" },
        "requirementIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "additionalProperties": true
    },
    "assetProfile": {
      "type": "object",
      "required": ["assetId", "version", "anchor", "scalePolicy", "operatingClearance"],
      "properties": {
        "assetId": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "anchor": { "enum": ["floor", "wall", "ceiling"] },
        "scalePolicy": { "enum": ["fixed", "bounded-proportional"] },
        "operatingClearance": {
          "type": "object",
          "required": ["front", "back", "left", "right", "top"],
          "properties": {
            "front": { "type": "number", "minimum": 0, "maximum": 5 },
            "back": { "type": "number", "minimum": 0, "maximum": 5 },
            "left": { "type": "number", "minimum": 0, "maximum": 5 },
            "right": { "type": "number", "minimum": 0, "maximum": 5 },
            "top": { "type": "number", "minimum": 0, "maximum": 5 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stair": {
      "type": "object",
      "required": ["stairId", "toLevelId", "position", "width", "runLength", "totalRise"],
      "properties": {
        "stairId": { "$ref": "#/$defs/id" },
        "toLevelId": { "$ref": "#/$defs/id" },
        "position": { "$ref": "#/$defs/point2" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "runLength": { "type": "number", "exclusiveMinimum": 0 },
        "totalRise": { "type": "number", "exclusiveMinimum": 0 },
        "headroom": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "guardrail": {
      "type": "object",
      "required": ["guardrailId", "start", "end"],
      "properties": {
        "guardrailId": { "$ref": "#/$defs/id" },
        "voidId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "maxLength": 160 },
        "start": { "$ref": "#/$defs/point2" },
        "end": { "$ref": "#/$defs/point2" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "thickness": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "void": {
      "type": "object",
      "required": ["voidId", "polygon"],
      "properties": {
        "voidId": { "$ref": "#/$defs/id" },
        "polygon": { "$ref": "#/$defs/polygon" }
      },
      "additionalProperties": true
    },
    "designIntent": {
      "type": "object",
      "required": ["style", "materials", "lighting", "maintenance"],
      "properties": {
        "style": { "type": "array", "items": {} },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "materialId": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1, "maxLength": 160 },
              "category": { "type": "string", "minLength": 1, "maxLength": 80 },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
              "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
              "opacity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            },
            "additionalProperties": true
          }
        },
        "lighting": { "type": "array", "items": { "type": "object" } },
        "rendering": {
          "type": "object",
          "properties": {
            "realtimeProfile": { "type": "string", "minLength": 1, "maxLength": 120 },
            "finalProfile": { "type": "string", "minLength": 1, "maxLength": 120 },
            "geometryLocked": { "type": "boolean" },
            "aiEnhancement": { "enum": ["off", "controlled"] },
            "controlPasses": { "type": "array", "items": { "enum": ["depth", "normal", "semantic", "object-id"] }, "uniqueItems": true },
            "exposure": { "type": "number", "minimum": 0.2, "maximum": 3 },
            "cameras": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": true
        },
        "maintenance": { "type": "array", "items": {} }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": ["decisionId", "summary", "rationale", "requirementIds"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/id" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "requirementIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "changes": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "scene": {
      "type": "object",
      "required": ["format", "formatVersion", "path", "sha256"],
      "properties": {
        "format": { "const": "pascal" },
        "formatVersion": { "type": "string", "minLength": 1 },
        "path": { "const": "scene.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "adapterVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": ["auditPath", "sha256", "blockingCount", "warningCount"],
      "properties": {
        "auditPath": { "const": "derived/audit.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "blockingCount": { "type": ["integer", "null"], "minimum": 0 },
        "warningCount": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["interiorDesignEngine", "adapter", "adapterVersion", "pascalCoreVersion", "pascalMcpVersion", "sourcePlanEvidenceId", "sourcePlanSha256"],
      "properties": {
        "interiorDesignEngine": { "const": "pascal-v2" },
        "adapter": { "const": "personal-agent-pascal" },
        "adapterVersion": { "type": "integer", "minimum": 1 },
        "pascalCoreVersion": { "type": "string", "minLength": 1 },
        "pascalMcpVersion": { "type": "string", "minLength": 1 },
        "sourcePlanEvidenceId": { "$ref": "#/$defs/id" },
        "sourcePlanSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": true
    }
  }
}
