{
  "schemaVersion": 2,
  "id": "interior-design-v5-workflow",
  "agentId": "interior-designer",
  "version": 7,
  "goal": "把装修资料和生活需求收敛为可理解、可传播、可逐阶段修改确认的设计工作区，并以经确认的全景节点组装 krpano 最终漫游。",
  "progressPage": { "required": true, "visibility": "private", "mobileFirst": true, "refreshPolicy": "every-transition", "folderPattern": "workflow-{agentId}-{projectKey}" },
  "interaction": {
    "maxQuestionsPerTurn": 3,
    "confirmationPolicy": "surface-aware-required",
    "revisionPolicy": "optimistic",
    "feedbackPolicy": "reopen-earliest-affected-stage",
    "recommendedCheckpoint": null
  },
  "stages": [
    {
      "id": "project-intake",
      "title": "项目输入",
      "purpose": "确认家庭、生活方式、预算、资料用途、排除项和待复尺边界。",
      "review": { "surface": "text", "artifactKind": null },
      "requiredFacts": ["brief-complete", "evidence-classified", "prior-design-answer-excluded", "scope-exclusions-visible"],
      "factRules": [{ "key": "brief-complete", "operator": "equals", "value": true }, { "key": "evidence-classified", "operator": "equals", "value": true }, { "key": "prior-design-answer-excluded", "operator": "equals", "value": true }, { "key": "scope-exclusions-visible", "operator": "equals", "value": true }],
      "requiredArtifacts": [],
      "confirmationPrompt": "请确认项目输入、历史资料用途和当前待复尺事项。",
      "next": "design-development"
    },
    {
      "id": "design-development",
      "title": "设计深化",
      "purpose": "建立毫米制空间、门窗、家具、柜体、天花、照明、电气、给排水和相机节点的统一设计数据。",
      "review": { "surface": "page", "artifactKind": "design-review-page" },
      "requiredFacts": ["geometry-authority-complete", "requirements-traceable", "clearances-checked", "design-boundary-visible"],
      "factRules": [{ "key": "geometry-authority-complete", "operator": "equals", "value": true }, { "key": "requirements-traceable", "operator": "equals", "value": true }, { "key": "clearances-checked", "operator": "equals", "value": true }, { "key": "design-boundary-visible", "operator": "equals", "value": true }],
      "requiredArtifacts": ["design-review-page"],
      "confirmationPrompt": "请核对空间关系、家具柜体、材料灯光和关键净距。",
      "next": "drawing-review"
    },
    {
      "id": "drawing-review",
      "title": "六类图纸确认",
      "purpose": "分别确认平面、天花灯具、开关控制、插座、给排水和柜体图纸；每张图均可单独修改。",
      "review": { "surface": "page", "artifactKind": "six-discipline-drawings" },
      "requiredFacts": ["six-drawings-generated", "drawing-semantics-independent", "drawing-revisions-recorded"],
      "factRules": [{ "key": "six-drawings-generated", "operator": "equals", "value": true }, { "key": "drawing-semantics-independent", "operator": "equals", "value": true }, { "key": "drawing-revisions-recorded", "operator": "equals", "value": true }],
      "requiredArtifacts": ["six-discipline-drawings", "drawing-plan-layout", "drawing-ceiling-lighting", "drawing-switch-control", "drawing-socket-layout", "drawing-plumbing", "drawing-cabinet"],
      "confirmationPrompt": "请逐张确认六类在线图纸，或指出需要修改的具体图纸。",
      "next": "spatial-sketch-review"
    },
    {
      "id": "spatial-sketch-review",
      "title": "3D 草图确认",
      "purpose": "通过可进入查看的语义 3D 草图确认门窗、动线、体量、柜体、灯具和全景相机位置。",
      "review": { "surface": "page", "artifactKind": "spatial-sketch-3d" },
      "requiredFacts": ["semantic-3d-generated", "room-entry-works", "panorama-nodes-visible"],
      "factRules": [{ "key": "semantic-3d-generated", "operator": "equals", "value": true }, { "key": "room-entry-works", "operator": "equals", "value": true }, { "key": "panorama-nodes-visible", "operator": "equals", "value": true }],
      "requiredArtifacts": ["spatial-sketch-3d"],
      "confirmationPrompt": "请进入各空间查看并确认 3D 草图及相机位置。",
      "next": "panorama-production"
    },
    {
      "id": "panorama-production",
      "title": "逐视角全景确认",
      "purpose": "每次只生成一张全景图，依次确认相机、基础全景和 Codex 图片增强结果；任一视角可独立重开。",
      "review": { "surface": "page", "artifactKind": "panorama-production-review" },
      "requiredFacts": ["one-image-per-generation", "view-confirmed", "image-confirmed", "all-panorama-nodes-confirmed"],
      "factRules": [{ "key": "one-image-per-generation", "operator": "equals", "value": true }, { "key": "view-confirmed", "operator": "equals", "value": true }, { "key": "image-confirmed", "operator": "equals", "value": true }, { "key": "all-panorama-nodes-confirmed", "operator": "equals", "value": true }],
      "requiredArtifacts": ["panorama-production-review"],
      "confirmationPrompt": "请确认当前这一张全景图和视角；确认后才进入下一张。",
      "next": "tour-review"
    },
    {
      "id": "tour-review",
      "title": "krpano 漫游走查",
      "purpose": "全部全景锁定后组装 krpano，走查场景载入、热点、方向、移动端和全屏体验。",
      "review": { "surface": "page", "artifactKind": "krpano-tour" },
      "requiredFacts": ["all-panoramas-confirmed", "licensed-runtime-present", "hotspots-verified", "tour-walkthrough-passed"],
      "factRules": [{ "key": "all-panoramas-confirmed", "operator": "equals", "value": true }, { "key": "licensed-runtime-present", "operator": "equals", "value": true }, { "key": "hotspots-verified", "operator": "equals", "value": true }, { "key": "tour-walkthrough-passed", "operator": "equals", "value": true }],
      "requiredArtifacts": ["krpano-tour", "tour-walkthrough"],
      "confirmationPrompt": "请走查最终漫游的画面、方向和热点跳转。",
      "next": "shareable-delivery"
    },
    {
      "id": "shareable-delivery",
      "title": "用户工作区交付",
      "purpose": "把设计册、六类图纸、3D 草图、全景漫游和待确认事项组织在同一可传播工作区。",
      "review": { "surface": "page", "artifactKind": "owner-page-final" },
      "requiredFacts": ["page-bundle-verified", "raw-evidence-private", "scope-boundary-visible", "artifact-workflow-complete"],
      "factRules": [{ "key": "page-bundle-verified", "operator": "equals", "value": true }, { "key": "raw-evidence-private", "operator": "equals", "value": true }, { "key": "scope-boundary-visible", "operator": "equals", "value": true }, { "key": "artifact-workflow-complete", "operator": "equals", "value": true }],
      "requiredArtifacts": ["owner-page-final"],
      "confirmationPrompt": "请确认工作区是否清晰、可转发并完整呈现最终漫游。",
      "next": "delivered"
    },
    {
      "id": "delivered",
      "title": "本轮完成",
      "purpose": "保留同一工作区入口；新反馈修改对应过程产物，并只使受影响的下游失效。",
      "review": { "surface": "terminal", "artifactKind": null },
      "requiredFacts": [],
      "factRules": [],
      "requiredArtifacts": [],
      "confirmationPrompt": null,
      "next": null
    }
  ]
}
