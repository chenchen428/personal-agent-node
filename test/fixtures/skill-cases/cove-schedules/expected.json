{
  "schemaVersion": 1,
  "capability": {
    "id": "schedules",
    "status": "implemented"
  },
  "task": {
    "name": "每日叶酸提醒",
    "cron": "0 21 * * *",
    "timezone": "Asia/Shanghai",
    "prompt": "提醒用户吃叶酸。",
    "enabled": true,
    "persistedVerificationRequired": true,
    "minimumIntervalMinutes": 15,
    "cloudIndependent": true
  },
  "calendar": {
    "mainAgentOnly": true,
    "spaceIsolated": true,
    "revisionBoundUpdates": true,
    "createsCron": false,
    "sendsParticipantMessages": false,
    "fixedPosterTemplate": true,
    "allItemsIncluded": true,
    "missingMobileLinkFails": true,
    "upcomingHasNoDefaultEnd": true,
    "nextEntryExcludesDoneAndCancelled": true,
    "ongoingIsSeparateFromNext": true,
    "nextDateTimeTextBeforePoster": true,
    "upcomingListsNextPerPlan": true,
    "dateRangesExpandOccurrences": true
  },
  "plan": {
    "unifiedStore": true,
    "modes": [
      "record",
      "remind",
      "execute"
    ],
    "defaultMode": "record",
    "recurrence": [
      "daily",
      "weekly",
      "monthly",
      "yearly"
    ],
    "scopes": [
      "series",
      "occurrence",
      "future"
    ],
    "revisionBound": true,
    "mainCapabilityRequired": true,
    "missedRunPolicies": [
      "skip",
      "latest"
    ],
    "occurrenceIdempotency": true,
    "legacyImportIdempotent": true,
    "interruptedExecutionNotReplayed": true
  }
}
